---
import type { AuthorEntry } from '../../types/contributors';
import { getInitials } from '../../utils/contributors';
import ContactButtons from './ContactButtons.astro';

interface Props {
  author: AuthorEntry;
}

const { author } = Astro.props;
---

<div class="bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-2xl p-6 sm:p-8 shadow-2xs hover:border-emerald-500/60 hover:shadow-sm transition-[border-color,box-shadow] duration-200 text-center flex flex-col items-center min-h-[460px]">
  {author.photo ? (
    <div
      class="relative rounded-full overflow-hidden mb-5 border-2 border-emerald-100 dark:border-emerald-900/50 shrink-0 bg-zinc-100 dark:bg-zinc-800 shadow-2xs aspect-square"
      style="width: 160px; height: 160px; min-width: 160px; min-height: 160px; max-width: 160px; max-height: 160px; border-radius: 50%; -webkit-mask-image: -webkit-radial-gradient(white, black);"
    >
      <img
        src={author.photo}
        alt={author.name}
        width="160"
        height="160"
        loading="eager"
        decoding="sync"
        
        class="absolute inset-0 w-full h-full object-cover object-center block"
        style="aspect-ratio: 1 / 1; border-radius: 50%; object-fit: cover;
  object-position: center;"
      />
    </div>
  ) : (
    <div
      class="rounded-full bg-emerald-600 text-white flex items-center justify-center text-4xl font-extrabold mb-5 select-none shrink-0 shadow-2xs aspect-square"
      style="width: 160px; height: 160px; min-width: 160px; min-height: 160px; max-width: 160px; max-height: 160px; border-radius: 50%;"
      aria-hidden="true"
    >
      {getInitials(author.name)}
    </div>
  )}

  <h3 class="font-bold text-base text-zinc-900 dark:text-zinc-100 leading-relaxed">
    {author.name}
  </h3>
  <span
    class="mt-2 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-300 dark:border-emerald-800/50"
    data-i18n-author-role
    data-role-en={author.role}
    data-role-ar={author.roleAr || author.role}
  >
    {author.role}
  </span>

  {author.badge && (
    <span
      class="mt-3 text-[10px] font-extrabold uppercase tracking-[0.12em] px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-200 dark:bg-amber-950/50 dark:text-amber-200 dark:border-amber-800"
      data-i18n-author-badge
      data-badge-en={author.badge.text}
      data-badge-ar={author.badge.textAr || author.badge.text}
    >
      {author.badge.text}
    </span>
  )}

  {author.bio && (
    <p
      class="mt-3 text-xs text-zinc-500 dark:text-zinc-400 leading-loose whitespace-pre-line"
      data-i18n-author-bio
      data-bio-en={author.bioEn || author.bio}
      data-bio-ar={author.bio}
    >
      {author.bioEn || author.bio}
    </p>
  )}

  {author.contacts && (
    <div class="mt-5 flex justify-center w-full">
      <ContactButtons contacts={author.contacts} showLabels={true} />
    </div>
  )}
</div>
