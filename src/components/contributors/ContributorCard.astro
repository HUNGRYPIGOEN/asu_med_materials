---
import type { ContributorStats } from '../../types/contributors';
import { getInitials } from '../../utils/contributors';
import ContactButtons from './ContactButtons.astro';

interface Props {
  contributor: ContributorStats;
  dialogId: string;
  rank: number;
  roleType?: 'creator' | 'resource';
}

const { contributor, dialogId, rank, roleType = 'creator' } = Astro.props;
const photo = contributor.profile?.photo;
const note = contributor.profile?.note;
const noteEn = contributor.profile?.noteEn;
const typeEntries = Object.entries(contributor.byType).sort((a, b) => b[1] - a[1]).slice(0, 4);
const yearEntries = Object.entries(contributor.byYear).sort((a, b) => Number(a[0]) - Number(b[0]));
const searchHref = `/search?q=${encodeURIComponent(contributor.name)}`;
---

<div class="relative contributor-card-container">
  <button
    type="button"
    data-contributor-trigger={dialogId}
    class="contributor-trigger w-full group bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-xl p-4 shadow-2xs hover:shadow-md hover:border-emerald-500/70 active:scale-[0.99] transition-all text-start flex items-center gap-3 cursor-pointer"
    aria-expanded="false"
    aria-controls={dialogId}
    aria-haspopup="dialog"
  >
    {photo ? (
      <div
        class="relative rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-700 shrink-0 bg-zinc-100 dark:bg-zinc-800 aspect-square"
        style="width: 52px; height: 52px; min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; border-radius: 50%; -webkit-mask-image: -webkit-radial-gradient(white, black);"
      >
        <img
          src={photo}
          alt={contributor.name}
          width="52"
          height="52"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-center block"
          style="aspect-ratio: 1 / 1; border-radius: 50%;"
        />
      </div>
    ) : (
      <span
        class="rounded-full bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 flex items-center justify-center text-sm font-extrabold shrink-0 select-none aspect-square"
        style="width: 52px; height: 52px; min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; border-radius: 50%;"
        aria-hidden="true"
      >
        {getInitials(contributor.name)}
      </span>
    )}
    <span class="flex-1 min-w-0">
      <span class="flex items-center gap-1.5">
        <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 shrink-0">#{rank}</span>
        <span class="font-bold text-sm text-zinc-900 dark:text-zinc-100 truncate group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          {contributor.name}
        </span>
      </span>
      <span class="mt-0.5 block text-[11px] text-zinc-500 dark:text-zinc-400">
        <span data-i18n="contributors.totalCount" data-i18n-params={JSON.stringify({ n: contributor.total })}>{contributor.total} مصدر</span> • <span data-i18n="contributors.clickDetails">اضغط للتفاصيل</span>
      </span>
      {note && (
        <span class="block text-[11px] text-zinc-400 dark:text-zinc-500 truncate">{note}</span>
      )}
    </span>
    <svg class="contributor-chevron w-4 h-4 text-zinc-400 shrink-0 rtl:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Popup Card positioned directly below clicked contributor card -->
  <div
    id={dialogId}
    data-contributor-popup={dialogId}
    role="dialog"
    aria-label={`Details for ${contributor.name}`}
    class="contributor-popup hidden absolute top-full right-0 rtl:right-0 ltr:left-0 z-40 mt-2.5 w-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700/90 rounded-2xl p-4 sm:p-5 shadow-xl shadow-zinc-900/10 dark:shadow-black/50 text-start before:content-[''] before:absolute before:-top-2 before:right-7 rtl:before:right-7 ltr:before:left-7 before:w-3.5 before:h-3.5 before:bg-white dark:before:bg-zinc-900 before:border-t before:border-r before:border-zinc-200 dark:before:border-zinc-700/90 before:rotate-[-45deg] before:z-10"
  >
    <!-- Header with Photo / Initials + Name + Rank + Close Button -->
    <div class="flex items-start justify-between gap-3 mb-3.5">
      <div class="flex items-center gap-3 min-w-0">
        {photo ? (
          <div
            class="relative rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-700 shrink-0 bg-zinc-100 dark:bg-zinc-800 aspect-square"
            style="width: 52px; height: 52px; min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; border-radius: 50%; -webkit-mask-image: -webkit-radial-gradient(white, black);"
          >
            <img
              src={photo}
              alt={contributor.name}
              width="52"
              height="52"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover object-center block"
              style="aspect-ratio: 1 / 1; border-radius: 50%;"
            />
          </div>
        ) : (
          <span
            class="rounded-full bg-emerald-600 text-white flex items-center justify-center text-lg font-black shrink-0 aspect-square"
            style="width: 52px; height: 52px; min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; border-radius: 50%;"
            aria-hidden="true"
          >
            {getInitials(contributor.name)}
          </span>
        )}
        <div class="min-w-0">
          <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 truncate">{contributor.name}</h3>
          <span
            class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5"
            data-i18n={roleType === 'resource' ? 'contributors.resourceRank' : 'contributors.rank'}
            data-i18n-params={JSON.stringify({ r: rank })}
          >
            {roleType === 'resource' ? `المرتبة #${rank} بين مساهمي المصادر` : `المرتبة #${rank} بين صناع المحتوى`}
          </span>
          {note && (
            <p
              class="text-[11px] text-zinc-500 dark:text-zinc-400 line-clamp-1 mt-0.5 whitespace-pre-line"
              data-i18n-contributor-note
              data-note-en={noteEn || note}
              data-note-ar={note}
            >
              {noteEn || note}
            </p>
          )}
        </div>
      </div>
      <button
        type="button"
        data-contributor-close
        class="p-1.5 rounded-lg text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer shrink-0"
        aria-label="إغلاق"
        data-i18n-attr="aria-label:common.close"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Quick Stats Grid (Total materials & subjects) -->
    <div class="grid grid-cols-2 gap-2 mb-3.5 text-center">
      <div class="rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-700/60 px-2 py-2">
        <div class="text-base font-extrabold text-emerald-600 dark:text-emerald-400">{contributor.total}</div>
        <div class="text-[10px] font-medium text-zinc-500 dark:text-zinc-400" data-i18n="contributors.totalResources">إجمالي المصادر</div>
      </div>
      <div class="rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/70 dark:border-zinc-700/60 px-2 py-2">
        <div class="text-base font-extrabold text-zinc-900 dark:text-zinc-100">{contributor.subjects}</div>
        <div class="text-[10px] font-medium text-zinc-500 dark:text-zinc-400" data-i18n="contributors.subjectsCount">مواد دراسية</div>
      </div>
    </div>

    <!-- By Type Pills -->
    {typeEntries.length > 0 && (
      <div class="mb-3">
        <h4 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1.5" data-i18n="contributors.byType">حسب نوع المصدر</h4>
        <div class="flex flex-wrap gap-1.5">
          {typeEntries.map(([type, count]) => (
            <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/50">
              <span data-i18n={`types.${type}`}>{type}</span>: <strong class="font-bold text-zinc-900 dark:text-zinc-100">{count}</strong>
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- By Year Pills -->
    {yearEntries.length > 0 && (
      <div class="mb-3.5">
        <h4 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-1.5" data-i18n="contributors.academicYears">السنوات الدراسية</h4>
        <div class="flex flex-wrap gap-1.5">
          {yearEntries.map(([year, count]) => {
            const isReferenceBucket = year === 'references';
            return (
              <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/50">
                <span data-i18n={isReferenceBucket ? 'categories.references' : 'nav.year'} data-i18n-params={isReferenceBucket ? undefined : JSON.stringify({ y: year })}>
                  {isReferenceBucket ? 'References' : `Year ${year}`}
                </span>
                : <strong class="font-bold text-zinc-900 dark:text-zinc-100">{count}</strong>
              </span>
            );
          })}
        </div>
      </div>
    )}

    <!-- Contacts (if provided) -->
    {contributor.profile?.contacts && (
      <div class="mb-3.5 pt-2 border-t border-zinc-100 dark:border-zinc-800">
        <ContactButtons contacts={contributor.profile.contacts} />
      </div>
    )}

    <!-- View contributions link button -->
    <a
      href={searchHref}
      class="w-full text-center text-xs font-bold py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white shadow-xs transition-colors flex items-center justify-center gap-1.5"
    >
      <span
        data-i18n={roleType === 'resource' ? 'contributors.viewAllAdded' : 'contributors.viewAll'}
        data-i18n-params={JSON.stringify({ n: contributor.total })}
      >
        {roleType === 'resource' ? `عرض كل المواد المضافة (${contributor.total})` : `عرض كل مصادره (${contributor.total})`}
      </span>
      <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
