---
// src/components/pwa/PwaInstallToast.astro
---

<script>
  import { isPwaInstalledOrStandalone, isIosDevice } from '../../utils/pwa';

  function initPwaInstallPrompt(): void {
    // CRITICAL: If the site is already a PWA or installed, NEVER show this toast
    if (isPwaInstalledOrStandalone()) {
      return;
    }

    const isYearPage = /^\/year\/(\d+)(\/.*)?$/.test(window.location.pathname || '');

    // Only show the install prompt when a year page is loaded, never on the home/start screen.
    if (!isYearPage) {
      return;
    }

    // Service worker is registered automatically by @vite-pwa/astro integration

    let deferredPrompt: any = null;

    // Check if dismissed in this browsing session
    let isDismissed = false;
    try {
      isDismissed = sessionStorage.getItem('asumed_pwa_prompt_dismissed') === 'true';
    } catch {}

    function showInstallNotification(isIos: boolean = false): void {
      if (isPwaInstalledOrStandalone() || isDismissed || !isYearPage) return;

      const showFn = (window as any).showToast;
      if (typeof showFn !== 'function') return;

      try {
        sessionStorage.setItem('asumed_pwa_prompt_dismissed', 'true');
      } catch {}
      isDismissed = true;

      const isAr = document.documentElement.lang === 'ar';

      if (isIos) {
        showFn({
          id: 'pwa-install-toast',
          type: 'pwa',
          title: isAr ? 'تثبيت التطبيق على الشاشة الرئيسية' : 'Install App to Home Screen',
          message: isAr
            ? 'اضغط على زر المشاركة في متصفح Safari ثم اختر "إضافة إلى الصفحة الرئيسية (+)".'
            : 'Tap the Share button in Safari and choose "Add to Home Screen (+)".',
          duration: 10000
        });
      } else {
        showFn({
          id: 'pwa-install-toast',
          type: 'pwa',
          title: isAr ? 'تثبيت التطبيق' : 'Install Web App',
          message: isAr
            ? 'نزّل الموقع كتطبيق خفيف على جهازك لتصفح المصادر بسرعة وبدون شريط المتصفح.'
            : 'Install this app on your device for faster access and offline capabilities.',
          duration: 0, // Keeps it visible until user action
          action: {
            label: isAr ? 'تثبيت الآن' : 'Install Now',
            onClick: async () => {
              if (deferredPrompt) {
                try {
                  deferredPrompt.prompt();
                  const choiceResult = await deferredPrompt.userChoice;
                  if (choiceResult?.outcome === 'accepted') {
                    localStorage.setItem('asumed_pwa_installed', 'true');
                  }
                } catch (e) {}
                deferredPrompt = null;
              }
            }
          }
        });
      }
    }

    // Standard PWA install trigger (Chrome, Edge, Android Chrome, Samsung Internet, Opera)
    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent browser default mini-infobar
      e.preventDefault();

      // Double-check if website is already running in standalone mode
      if (isPwaInstalledOrStandalone() || !isYearPage) {
        return;
      }

      deferredPrompt = e;

      // Display toast after a short delay for optimal user experience
      setTimeout(() => {
        showInstallNotification(false);
      }, 2500);
    });

    // Handle iOS Safari guidance if not already installed as standalone
    if (isIosDevice() && !isPwaInstalledOrStandalone() && !isDismissed && isYearPage) {
      setTimeout(() => {
        if (!isPwaInstalledOrStandalone() && isYearPage) {
          showInstallNotification(true);
        }
      }, 4000);
    }

    // Listen for app installed event to permanently silence the toast
    window.addEventListener('appinstalled', () => {
      try {
        localStorage.setItem('asumed_pwa_installed', 'true');
      } catch {}
      deferredPrompt = null;
      const toastEl = document.querySelector('[data-toast-id="pwa-install-toast"]');
      if (toastEl) toastEl.remove();
    });
  }

  // Initialize on page load and on view transitions
  initPwaInstallPrompt();
  document.addEventListener('astro:after-swap', initPwaInstallPrompt);
</script>
