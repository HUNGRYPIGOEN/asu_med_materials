---
const years = [
  { year: 1, titleAr: 'السنة الأولى', titleEn: 'Year 1', desc: 'قريباً' },
  { year: 2, titleAr: 'السنة الثانية', titleEn: 'Year 2', desc: 'Blood & Lymphatic System' },
  { year: 3, titleAr: 'السنة الثالثة', titleEn: 'Year 3', desc: 'قريباً' },
  { year: 4, titleAr: 'السنة الرابعة', titleEn: 'Year 4', desc: 'قريباً' },
  { year: 5, titleAr: 'السنة الخامسة', titleEn: 'Year 5', desc: 'قريباً' },
];
---

<!-- Year Selection Modal (Single-step, based on legacy multistage design) -->
<div
  id="multistage-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/60 backdrop-blur-xs hidden transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="year-selector-title"
>
  <div class="relative w-full max-w-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-2xl p-6 overflow-hidden">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <h2
        id="year-selector-title"
        class="text-xl font-bold text-zinc-900 dark:text-zinc-100"
        data-i18n="selector.title"
      >
        Choose Academic Year
      </h2>

      <!-- Close Button -->
      <button
        type="button"
        id="close-multistage-btn"
        class="p-2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        data-i18n-attr="aria-label:selector.closeLabel"
        aria-label="Close"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Academic Years List (Single-step) -->
    <div class="grid grid-cols-1 gap-2.5 max-h-80 overflow-y-auto pr-1">
      {years.map((y) => (
        <button
          type="button"
          data-stage-year={y.year}
          class="stage-year-btn group flex items-center justify-between p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40 hover:bg-emerald-50 dark:hover:bg-emerald-950/30 hover:border-emerald-500 transition-all text-start cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 flex items-center justify-center font-bold text-sm">
              Y{y.year}
            </div>
            <div>
              <h3
                class="font-bold text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"
                data-i18n="nav.year"
                data-i18n-params={JSON.stringify({ y: y.year })}
              >
                {y.titleEn}
              </h3>
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
                {y.desc}
              </p>
            </div>
          </div>
          <svg class="w-4 h-4 text-zinc-400 group-hover:text-emerald-600 rtl:-rotate-180 rtl:group-hover:-translate-x-1 ltr:group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  import { getUserStoredYear } from '../../utils/storage';
  import { getHasVisited, setHasVisited } from '../../utils/storage';

  function initYearSelector(): void {
    const modal = document.getElementById('multistage-modal');
    const closeBtn = document.getElementById('close-multistage-btn');
    const yearButtons = document.querySelectorAll('.stage-year-btn');
    const triggers = document.querySelectorAll('.trigger-multistage-selector');

    function showModal(): void {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.setAttribute('data-modal-open', 'true');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function hideModal(): void {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.setAttribute('data-modal-open', 'false');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // First-visit auto-show logic:
    // show the welcome quote first on initial load, then open the year selector after the quote is dismissed
    if (!getHasVisited() && !getUserStoredYear()) {
      const welcomeQuoteModal = document.getElementById('welcome-quote-modal');
      const quoteAlreadyDismissed = window.sessionStorage.getItem('asu-med-welcome-quote-dismissed') === 'true';

      if (welcomeQuoteModal && !quoteAlreadyDismissed) {
        window.addEventListener(
          'welcome-quote-dismissed',
          () => {
            if (!getHasVisited() && !getUserStoredYear()) {
              setHasVisited();
              showModal();
            }
          },
          { once: true }
        );
      } else {
        setHasVisited();
        showModal();
      }
    }

    yearButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const yStr = btn.getAttribute('data-stage-year');
        if (yStr) {
          const year = parseInt(yStr, 10);
          localStorage.setItem('asumed_user_year', String(year));
          window.dispatchEvent(new CustomEvent('user-preferences-updated', { detail: { year } }));
          hideModal();
          window.location.href = `/year/${year}`;
        }
      });
    });

    closeBtn?.addEventListener('click', hideModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        hideModal();
      }
    });

    if (!selectorInitialized) {
      selectorInitialized = true;
      window.addEventListener('keydown', (e) => {
        const m = document.getElementById('multistage-modal');
        if (e.key === 'Escape' && m && !m.classList.contains('hidden')) {
          hideModal();
        }
      });
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', showModal);
    });
  }

  let selectorInitialized = false;
  initYearSelector();
  document.addEventListener('astro:after-swap', initYearSelector);
</script>