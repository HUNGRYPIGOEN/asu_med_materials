---
import MaterialReviewFields from './MaterialReviewFields.astro';
import type { ModuleInfo } from '../../types/materials';

interface Props {
  modules: ModuleInfo[];
}

const { modules } = Astro.props;
---

<div id="admin-direct-form-root" data-modules={JSON.stringify(modules)} class="space-y-6 text-start">
  <!-- Sourced Student Submission Banner (Visible when reviewing a submission) -->
  <div id="admin-source-submission-banner" class="hidden p-3.5 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/40 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="text-base">📥</span>
      <div>
        <div class="text-xs font-bold text-amber-900 dark:text-amber-200" id="admin-source-sub-text">
          مراجعة مساهمة طلابية
        </div>
        <div class="text-[11px] text-amber-700 dark:text-amber-400">
          سيتم اعتماد المساهمة تلقائياً بمجرد نشر المواد المحددة.
        </div>
      </div>
    </div>
    <button
      type="button"
      id="admin-source-sub-cancel-btn"
      class="text-xs px-2.5 py-1 rounded-lg border border-amber-300 dark:border-amber-700/60 text-amber-800 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/40 cursor-pointer font-semibold"
    >
      إلغاء الربط
    </button>
  </div>

  <!-- 1. AI WhatsApp / Message Parser Card -->
  <div class="p-4 sm:p-5 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-800/40">
    <div class="flex items-center justify-between gap-2 mb-1.5">
      <div class="flex items-center gap-2">
        <span class="text-base">✨</span>
        <h3 class="text-xs font-bold text-emerald-900 dark:text-emerald-200" data-i18n="admin.aiAssistantTitle">
          AI Study Material Assistant (Gemini 3.8 Flash)
        </h3>
      </div>
      <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300">
        يدعم روابط متعددة دفعة واحدة
      </span>
    </div>
    <p class="text-[11px] text-emerald-700 dark:text-emerald-400 mb-3" data-i18n="admin.aiAssistantSubtitle">
      الصق رسائل الواتساب أو تيليجرام أو قائمة الروابط لاستخراج المواد تلقائياً وتجهيزها للنشر مع فحص التكرار
    </p>

    <div class="space-y-2.5">
      <textarea
        id="admin-ai-input"
        rows="3"
        placeholder="الصق رسالة الواتساب أو قائمة الروابط هنا، مثلاً: تفريغات د. شيرين باثولوجي بلود https://... وقناة التليجرام https://t.me/..."
        data-i18n-attr="placeholder:admin.aiInputPlaceholder"
        class="w-full px-3 py-2 text-xs bg-white dark:bg-zinc-900 border border-emerald-200 dark:border-emerald-800/60 rounded-xl text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 font-sans leading-relaxed transition-all resize-y"
      ></textarea>

      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="admin-ai-extract-btn"
            class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-xs font-bold transition-all shadow-xs flex items-center gap-1.5 cursor-pointer disabled:opacity-50"
          >
            <span>✨</span>
            <span id="admin-ai-btn-text" data-i18n="admin.aiParseBtn">Extract with AI</span>
          </button>

          <button
            type="button"
            id="admin-add-manual-bulk-btn"
            class="px-3 py-2 rounded-xl border border-emerald-300 dark:border-emerald-700/60 bg-white dark:bg-zinc-900 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 text-xs font-semibold transition-all cursor-pointer"
          >
            <span>+ إضافة مادة يدوياً للقائمة</span>
          </button>
        </div>

        <div id="admin-ai-notice" class="hidden text-[11px] font-semibold text-emerald-700 dark:text-emerald-300">
          <span data-i18n="admin.aiSuccessNotice">✨ تم استخراج البيانات بنجاح! راجع الحقول أدناه ثم اضغط نشر.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Bulk Review Staging Area (Shown when multiple items are extracted/staged) -->
  <div id="admin-bulk-staging" class="hidden space-y-4">
    <div class="p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/80 space-y-4">
      <!-- Staging Header & Action Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-200 dark:border-zinc-700/80 pb-3">
        <div>
          <h4 class="text-xs font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <span>📦</span>
            <span id="admin-bulk-staging-title">المواد المستخرجة في الانتظار (0)</span>
          </h4>
          <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-0.5">
            راجع البيانات، عدل العناوين والتصنيفات، وسيتم استبعاد المواد المكررة تلقائياً.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
          <button
            type="button"
            id="admin-bulk-skip-dups-btn"
            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 hover:bg-amber-200 dark:hover:bg-amber-900/60 transition-all cursor-pointer flex items-center gap-1"
            title="إلغاء تحديد أي مادة مكررة مسبقاً"
          >
            <span>⚠️</span>
            <span>استبعاد المكرر</span>
          </button>
          <button
            type="button"
            id="admin-bulk-select-all-btn"
            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-all cursor-pointer"
          >
            تحديد الكل
          </button>
          <button
            type="button"
            id="admin-bulk-clear-btn"
            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-all cursor-pointer"
          >
            مسح القائمة
          </button>
          <button
            type="button"
            id="admin-bulk-switch-single-btn"
            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all cursor-pointer"
          >
            النموذج الفردي
          </button>
        </div>
      </div>

      <!-- Staged Cards List -->
      <div id="admin-bulk-cards-list" class="space-y-3"></div>

      <!-- Bulk Publish Action Bar -->
      <div class="pt-2 border-t border-zinc-200 dark:border-zinc-700/80 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div id="admin-bulk-status-text" class="text-xs text-zinc-500 dark:text-zinc-400">
          المحدد للنشر: <strong id="admin-bulk-selected-count" class="text-emerald-600">0</strong> مواد
        </div>

        <button
          type="button"
          id="admin-bulk-publish-btn"
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span id="admin-bulk-publish-btn-text">نشر المواد المحددة دفعة واحدة</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Direct Single Material Form -->
  <form id="admin-direct-form" class="space-y-4">
    <div id="admin-single-editor"></div>

    <!-- Error message box -->
    <div id="admin-direct-error" class="hidden p-3 rounded-xl text-xs bg-rose-50 dark:bg-rose-950/50 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800/40"></div>

    <!-- Submit Action -->
    <div class="pt-2 flex flex-col sm:flex-row items-center gap-2">
      <button
        type="submit"
        id="admin-direct-submit-btn"
        class="flex-1 py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
      >
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span id="admin-direct-btn-text" data-i18n="admin.publishDirectBtn">Publish Directly to Database</span>
      </button>

      <button
        type="button"
        id="admin-add-to-staging-btn"
        class="w-full sm:w-auto py-2.5 px-4 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 text-xs font-semibold transition-all cursor-pointer"
        title="إضافة هذه المادة لقائمة الدفعة للمراجعة قبل النشر"
      >
        + إضافة للقائمة
      </button>
    </div>
  </form>
</div>

<MaterialReviewFields />
<script>
  import { initDirectMaterialForm } from '../../scripts/admin/directMaterialForm';
  initDirectMaterialForm();
  document.addEventListener('astro:after-swap', initDirectMaterialForm);
</script>
